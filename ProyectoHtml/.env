NEXT_PUBLIC_SUPABASE_URL=https://vwjinrgkgquupwrtekmu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_lW_GZEVpSi2WuaXA03ivvA_BhnRhH7F
SUPABASE_POOLER_HOST=aws-1-us-east-1.pooler.supabase.com

# Si prefieres una variable dedicada para la key, usa:
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#
# En este proyecto, si db_type=supabase y db_password empieza por sb_,
# el servidor la toma como fallback para la publishable key.
#
# Si el host directo db.<project-ref>.supabase.co falla por IPv6, usa el pooler:
# SUPABASE_POOLER_HOST=aws-0-REGION.pooler.supabase.com
#
# Si usas SUPABASE_POOLER_HOST, el servidor puede derivar el usuario
# postgres.<project-ref> automaticamente desde db_host.
#
# Si prefieres usar una URL completa, puedes usar una de estas variables:
# DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.vwjinrgkgquupwrtekmu.supabase.co:5432/postgres
# SUPABASE_DB_URL=postgresql://postgres:TU_PASSWORD@db.vwjinrgkgquupwrtekmu.supabase.co:5432/postgres
#
# Para pooler suele verse asi:
# DATABASE_URL=postgresql://postgres.vwjinrgkgquupwrtekmu:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
